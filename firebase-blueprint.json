{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile and subscription status",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["inactive", "active", "cancelled"],
          "description": "Status of the subscription"
        },
        "planType": {
          "type": "string",
          "description": "Subscribed plan identifier (none or monthly_etb)"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time",
          "description": "Expiration timestamp of the subscription"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["email", "subscriptionStatus", "planType"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile with personal subscription state"
    }
  }
}
